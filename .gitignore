# Whitelist: mặc định bỏ qua mọi file/thư mục ở gốc repo
# (file build như .ipa, .apk, build/, .dart_tool/, .idea/... sẽ không bị git track).
/*

# --- Cho phép ở gốc repo ---
!/.gitignore
!/.metadata
!/.claude
!/.github/
!/AGENTS.md
!/CLAUDE.md
!/Makefile
!/README.md
!/analysis_options.yaml
!/pubspec.yaml
!/pubspec.lock

!/lib/
!/test/
!/android/
!/ios/
!/docs/
!/scripts/
!/assets/

# --- Bỏ qua file rác/build phát sinh bên trong thư mục được cho phép ---
# (android/.gitignore và ios/.gitignore vẫn có hiệu lực riêng)
.DS_Store
*.class
*.log
*.pyc
*.swp
*.iml
*.ipr
*.iws
*.ipa
*.apk
*.aab
**/doc/api/
**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release
